# ═══════════════════════════════════════════════════════════════════
# 🚀 TELEGRAM MINI APP E-COMMERCE - EXAMPLE ENVIRONMENT FILE
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# Never commit .env with real secrets to version control!

# ═══════════════════════════════════════════════════════════════════
# 🤖 TELEGRAM BOT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Get from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here_from_botfather

# Your Telegram User ID (for admin features)
ADMIN_IDS=your_telegram_id_here

# Password for /admin command
ADMIN_PASSWORD=change_this_password_123

# ═══════════════════════════════════════════════════════════════════
# 🌐 WEB APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════

# For development
API_URL=http://127.0.0.1:8000
WEB_APP_URL=http://127.0.0.1:8000
WEB_APP_ADMIN_URL=http://127.0.0.1:8000/admin

# For production (replace with your domain)
# API_URL=https://api.yourdomain.com
# WEB_APP_URL=https://shop.yourdomain.com
# WEB_APP_ADMIN_URL=https://shop.yourdomain.com/admin

# Application settings
FASTAPI_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════
# 💾 DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# SQLite (simple, no setup required)
DATABASE_URL=sqlite:///shop.db
DB_NAME=shop.db

# PostgreSQL (for production, optional)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shop_db

# ═══════════════════════════════════════════════════════════════════
# 🔒 SECURITY
# ═══════════════════════════════════════════════════════════════════

# Secret key for sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-generate-with-command-above

# JWT Secret for API tokens
JWT_SECRET_KEY=your-jwt-secret-key

# ═══════════════════════════════════════════════════════════════════
# 📮 NOVA POSHTA API (Ukrainian Logistics)
# ═══════════════════════════════════════════════════════════════════

# Get API key from your Nova Poshta personal account
NOVA_POSHTA_API_KEY=your_nova_poshta_api_key

# Sender city (Kyiv = 8d5a980d-391c-11dd-90d9-001a92567626)
NOVA_POSHTA_SENDER_CITY_REF=8d5a980d-391c-11dd-90d9-001a92567626

# Sender contact references (get from your account)
NOVA_POSHTA_SENDER_REF=your_sender_ref
NOVA_POSHTA_SENDER_ADDRESS_REF=your_address_ref
NOVA_POSHTA_SENDER_CONTACT_REF=your_contact_ref

# ═══════════════════════════════════════════════════════════════════
# 💳 PAYMENT SYSTEMS
# ═══════════════════════════════════════════════════════════════════

# LiqPay (Ukrainian)
LIQPAY_PUBLIC_KEY=your_liqpay_public_key
LIQPAY_PRIVATE_KEY=your_liqpay_private_key

# Monobank
MONOBANK_TOKEN=your_monobank_token

# Wayforpay
WAYFORPAY_MERCHANT_ID=your_merchant_id
WAYFORPAY_SECRET_KEY=your_secret_key

# ═══════════════════════════════════════════════════════════════════
# 📧 EMAIL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Gmail example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email settings
EMAIL_FROM=noreply@yourshop.com
EMAIL_FROM_NAME=Your Shop Name

# ═══════════════════════════════════════════════════════════════════
# 📱 SMS CONFIGURATION (optional)
# ═══════════════════════════════════════════════════════════════════

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════════════════════════════════
# 🎯 SHOP SETTINGS
# ═══════════════════════════════════════════════════════════════════

# Shop settings
SHOP_NAME=Electric Pro
SHOP_DESCRIPTION=Your Shop Description

# Currency
CURRENCY=₴
CURRENCY_CODE=UAH

# Order settings
MIN_ORDER_AMOUNT=0
FREE_SHIPPING_THRESHOLD=1000

# ═══════════════════════════════════════════════════════════════════
# 🎮 GAMIFICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════

# Bonuses and rewards
REFERRAL_BONUS=50
CASHBACK_PERCENT=2
MAX_BONUS_MULTIPLIER=2.0

# ═══════════════════════════════════════════════════════════════════
# 🔔 NOTIFICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════

ENABLE_TELEGRAM_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false

# ═══════════════════════════════════════════════════════════════════
# 📊 ANALYTICS & MONITORING
# ═══════════════════════════════════════════════════════════════════

GOOGLE_ANALYTICS_ID=
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════
# 🔍 REDIS CONFIGURATION (optional)
# ═══════════════════════════════════════════════════════════════════

# REDIS_URL=redis://localhost:6379/0
# CACHE_ENABLED=true
# CACHE_TTL_PRODUCTS=3600
# CACHE_TTL_USERS=1800

# ═══════════════════════════════════════════════════════════════════
# 📂 FILE UPLOAD SETTINGS
# ═══════════════════════════════════════════════════════════════════

MAX_FILE_SIZE=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp4,mov

# ═══════════════════════════════════════════════════════════════════
# 🐳 DOCKER SETTINGS
# ═══════════════════════════════════════════════════════════════════

DOCKER_ENV=false
DOCKER_PORT=8000
NGINX_PORT=80

# ═══════════════════════════════════════════════════════════════════
# 🧪 DEVELOPMENT & TESTING
# ═══════════════════════════════════════════════════════════════════

DEVELOPMENT_MODE=true
TEST_MODE=false

# ═══════════════════════════════════════════════════════════════════
# 📅 CRON JOBS & CLEANUP
# ═══════════════════════════════════════════════════════════════════

ABANDONED_CART_REMINDER_HOURS=24
ARCHIVE_ORDERS_DAYS=180
RFM_RECALC_DAY_OF_WEEK=1
PRICE_HISTORY_RETENTION_DAYS=365
